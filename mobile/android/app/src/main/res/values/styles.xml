<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Colori del sito (palette "ink & mint", src/app/globals.css): fondo felt, mai bianco pieno. -->
    <color name="om_felt">#150C2C</color>
    <color name="om_logo">#0B2E25</color>
    <color name="om_mint">#31E3BD</color>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/om_felt</item>
        <item name="colorPrimaryDark">@color/om_felt</item>
        <item name="colorAccent">@color/om_mint</item>
        <item name="android:windowBackground">@color/om_felt</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/om_felt</item>
        <item name="colorAccent">@color/om_mint</item>
    </style>

    <!-- Avvio: la carta del logo su un cerchio verde, sul fondo del sito (API SplashScreen, anche prima di Android 12). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/om_felt</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/om_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
