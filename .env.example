# Copia in .env.local (non committato). I due valori pubblici hanno un default in src/lib/supabase/env.ts:
# servono solo per puntare a un altro progetto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# NEXT_PUBLIC_COMMUNITY=off   # spegne account, pubblicazione e voti

# Solo per scripts/db-migrate.mjs (applica supabase/schema.sql); mai nel browser.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=...
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<project-ref>
# Google Analytics 4 (ID pubblico; il tag parte solo con il consenso cookie). Default nel codice: G-RCGV4S861S
NEXT_PUBLIC_GA_ID=G-RCGV4S861S
