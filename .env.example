# Copia in .env.local (non committato). I due valori pubblici hanno un default in src/lib/supabase/env.ts:
# servono solo per puntare a un altro progetto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# NEXT_PUBLIC_COMMUNITY=off   # spegne account, pubblicazione e voti

# Solo per scripts/db-migrate.mjs (applica supabase/schema.sql); mai nel browser.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=...
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<project-ref>
# CAPTCHA Cloudflare Turnstile sul modulo di accesso: chiave del sito (pubblica, sta nell'HTML).
# Senza questa variabile il widget non compare e l'accesso funziona come prima. La chiave segreta NON va qui:
# si incolla nella dashboard Supabase (Authentication → Attack protection). Chiavi di prova di Cloudflare:
# 1x00000000000000000000AA passa sempre, 2x00000000000000000000AB fallisce sempre.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 (ID pubblico; il tag parte solo con il consenso cookie). Default nel codice: G-9J5Q803XJS
NEXT_PUBLIC_GA_ID=G-9J5Q803XJS
# Notifiche Discord dei tornei (solo server, MAI con NEXT_PUBLIC_): URL del webhook del canale. Senza, nessun messaggio.
# DISCORD_WEBHOOK_URL=
# Pop-up dei feedback (dal 22/09/2026, src/components/FeedbackWidget.tsx). Acceso di default: per spegnerlo dopo il
# rodaggio si imposta NEXT_PUBLIC_FEEDBACK=off su Vercel e si rifà il deploy (la variabile entra nel codice alla build).
# NEXT_PUBLIC_FEEDBACK=off
# Canale Discord PRIVATO dello staff che riceve i feedback (solo server, MAI con NEXT_PUBLIC_): URL del webhook,
# https://discord.com/api/webhooks/<id>/<token>. Senza, /api/feedback risponde 503 e il bottone dei feedback non compare.
# DISCORD_FEEDBACK_WEBHOOK_URL=
# Chiave SEGRETA di Turnstile per le rotte che verificano il CAPTCHA da sole (/api/ask, /api/feedback). Solo server.
# Senza, le due rotte non chiedono il controllo (e se c'è la site key lo scrivono nei log: il widget sarebbe di facciata).
# Per l'accesso invece la chiave segreta sta nella dashboard Supabase.
# TURNSTILE_SECRET_KEY=
